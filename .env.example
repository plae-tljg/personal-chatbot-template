# Copy to .env and fill in. `.env` is gitignored; this file is not.
#
# The fallback rung (docs/CONCERNS.md C1) is consulted only when every
# deterministic rung refused. Any OpenAI-compatible endpoint works; set the
# matching pair in content/bot.json -> runtime.fallback.

# OpenCode Zen -- has a free model pool. https://opencode.ai/auth
OPENCODE_API_KEY=

# DeepSeek -- https://platform.deepseek.com
# DEEPSEEK_API_KEY=

# A local Ollama needs no key at all: set api_key_env to "" and point the
# endpoint at http://localhost:11434/v1/chat/completions
