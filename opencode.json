{
  "$schema": "https://opencode.ai/config.json",
  "_note": [
    "Config for running the maintenance agent on this repo.",
    "The runtime never uses any of this: no model runs while serving.",
    "Reading is unlimited: `pc sql` opens the database read-only, so SQLite itself",
    "refuses a write. Writing is limited to content/ -- not because the agent is",
    "distrusted, but because data/bot.db is a projection and a write there is lost on",
    "the next build. See .opencode/README.md."
  ],
  "instructions": [
    "docs/LEVELS.md",
    "docs/CONCERNS.md"
  ],
  "permission": {
    "bash": {
      "*": "ask",
      "git push*": "deny",
      "rm *": "deny",
      "sudo *": "deny"
    }
  },
  "agent": {
    "maintainer": {
      "description": "Runs one maintenance round. Edits content/ only, never the engine, never the database.",
      "mode": "primary",
      "model": "opencode/space-bunny-free",
      "temperature": 0.1,
      "prompt": "{file:./skills/maintain-round.md}",
      "permission": {
        "edit": {
          "*": "deny",
          "content/*": "allow",
          "content/**": "allow"
        },
        "bash": {
          "*": "ask",
          "python -m personal_chatbots *": "allow",
          "pc *": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git add content/*": "allow",
          "git commit*": "ask",
          "git push*": "deny",
          "rm *": "deny",
          "ls *": "allow",
          "grep *": "allow",
          "rg *": "allow",
          "wc *": "allow",
          "sqlite3 *": "deny",
          "git branch*": "allow",
          "git show*": "allow",
          "git remote*": "allow",
          "echo *": "allow",
          "python -m personal_chatbots sql*": "allow",
          "pc sql*": "allow",
          "python -m unittest *": "allow",
          "tail *": "allow",
          "head *": "allow",
          "sort *": "allow",
          "uniq *": "allow",
          "cut *": "allow",
          "diff *": "allow",
          "find *": "allow",
          "test *": "allow",
          "true": "allow"
        },
        "webfetch": "deny"
      }
    },
    "reviewer": {
      "description": "Reads the inbox and reports what is failing and what it would cost to fix. Changes nothing.",
      "mode": "primary",
      "model": "opencode/space-bunny-free",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask",
          "python -m personal_chatbots *": "allow",
          "pc *": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git add*": "deny",
          "git commit*": "deny",
          "git push*": "deny",
          "rm *": "deny",
          "ls *": "allow",
          "grep *": "allow",
          "rg *": "allow",
          "wc *": "allow",
          "sqlite3 *": "deny",
          "git branch*": "allow",
          "git show*": "allow",
          "git remote*": "allow",
          "echo *": "allow",
          "python -m personal_chatbots sql*": "allow",
          "pc sql*": "allow",
          "python -m unittest *": "allow",
          "tail *": "allow",
          "head *": "allow",
          "sort *": "allow",
          "uniq *": "allow",
          "cut *": "allow",
          "diff *": "allow",
          "find *": "allow",
          "test *": "allow",
          "true": "allow"
        },
        "webfetch": "deny"
      }
    }
  }
}
